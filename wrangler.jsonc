// Configuration Cloudflare Workers de « Potentiel caché ».
// Développement local : `npm run dev` (wrangler dev).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "potentiel-cache",
  "main": "src/worker.js",
  // 2026-09-02 = date la plus récente supportée par le workerd de wrangler 4.127.0.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Fichiers statiques (écran commun, téléphone, fiche, outil solo).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true }
}
